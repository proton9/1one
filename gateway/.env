# Non-secret defaults only. Secrets live in .env.local (git-ignored).
# Symfony loads .env first, then .env.local to override.
APP_ENV=dev
APP_DEBUG=0

# These URLs are non-secret. Credentials are substituted from .env.local.
DATABASE_URL="mysql://app:app@mysql:3306/gateway?serverVersion=8.0"
REDIS_DSN=redis://redis:6379
MESSENGER_TRANSPORT_DSN="${REDIS_DSN}/messages"
PROVIDER_BASE_URL=http://mock-provider:8001
PROVIDER_MAC_ID=gateway-app

# The following MUST be provided via .env.local (or .env.prod.local in production):
#   APP_SECRET
#   PROVIDER_MAC_KEY
#   WEBHOOK_SECRET
