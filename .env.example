# Copy this file to .env and fill in real values before running `docker compose up`.
# The .env file is git-ignored and must never be committed.

# Symfony
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-to-a-random-32-byte-hex-string

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=gateway
MYSQL_USER=app
MYSQL_PASSWORD=change-me

# Provider MAC auth (shared secret with mock-provider)
PROVIDER_MAC_ID=gateway-app
PROVIDER_MAC_KEY=change-me-to-a-random-secret

# Webhook signing (shared secret with mock-merchant)
WEBHOOK_SECRET=change-me-to-a-random-secret
